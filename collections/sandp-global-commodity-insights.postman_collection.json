  "info": {
    "_postman_id": "56dfa4bf-0a2a-4f13-a2c1-4c17c10f8533",
    "name": "S&P Global Commodity Insights API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The S&P Global Commodity Insights API (formerly Platts API) provides RESTful access to commodity price assessments, market data, and analytics across energy, metals, agriculture, and petrochemicals markets. Bearer token authentication is required, with tokens generated via the Token Generation API using S&P Global SSO credentials.\n\nContact Support:\n Name: S&P Global Commodity Insights Support",
      "type": "text/plain"
    }
  }
